# Auto-detect text files and normalize to LF in the repository
* text=auto

# Explicitly enforce LF line endings for shell scripts and CI workflows
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Treat binary files as binary
*.zip binary
*.tar.gz binary
*.exe binary
*.asar binary
